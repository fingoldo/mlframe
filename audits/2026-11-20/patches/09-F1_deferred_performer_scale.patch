+def _performer_directions(rng: np.random.Generator, d_input: int, n_features: int) -> np.ndarray:
+    """Unscaled Gaussian directions ``W ~ N(0, I)`` of shape ``(d_input, n_features)`` for the positive random features.
+
+    With ``phi(x) = exp(W^T x - ||x||^2 / 2)`` and unscaled ``W``, ``E[phi(q) . phi(k)] = exp(q . k)`` exactly (the softmax kernel the
+    module describes). Dividing ``W`` by ``sqrt(d_input)`` made the kernel ``exp(q . k / d)`` times a norm-dependent factor, so the estimate
+    was neither the softmax kernel nor a constant rescaling of it.
+    """
+    return rng.standard_normal((d_input, n_features)).astype(np.float32)
+
+
