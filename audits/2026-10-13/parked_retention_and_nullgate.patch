+def _conditional_null_passes(factors_data, y_idx, cand_idx, sel_idxs, n_perm=20, quantile=0.99, seed=0) -> bool:
+    """Whether I(cand; y | selected) clears the ``quantile`` of the same statistic under a within-stratum permutation.
+
+    The absolute gain floor sits far below the plug-in bias of a conditional MI at moderate n (a 10-bin decoy of a
+    selected operand reads ~0.003 at n=4000 against a null mean of ~0.002), so noise-level candidates passed it. Permuting
+    the candidate inside the strata of the selected set keeps their association and breaks only the candidate-target link.
+    """
+    from sklearn.metrics import mutual_info_score
+
+    y_codes = np.asarray(factors_data[:, y_idx]).astype(np.int64).ravel()
+    x_codes = np.asarray(factors_data[:, cand_idx]).astype(np.int64).ravel()
+    s_codes = np.zeros(y_codes.shape[0], dtype=np.int64)
+    for j in sel_idxs:
+        col = np.asarray(factors_data[:, j]).astype(np.int64).ravel()
+        s_codes = s_codes * (int(col.max()) + 1) + col
+
+    def _cmi(x):
+        total = 0.0
+        n = y_codes.shape[0]
+        for sv in np.unique(s_codes):
+            m = s_codes == sv
+            k = int(m.sum())
+            if k < 30:
+                continue
+            total += (k / n) * mutual_info_score(x[m], y_codes[m])
+        return total
+
+    rng = np.random.default_rng(seed)
+    null = np.empty(n_perm, dtype=np.float64)
+    for i in range(n_perm):
+        perm = x_codes.copy()
+        for sv in np.unique(s_codes):
+            idx = np.flatnonzero(s_codes == sv)
+            perm[idx] = x_codes[rng.permutation(idx)]
+        null[i] = _cmi(perm)
+    return _cmi(x_codes) > float(np.quantile(null, quantile))
+
